{
    "name": "laravelui5/odata",
    "description": "Multi-OData endpoint support for Laravel",
    "type": "library",
    "keywords": [
        "odata",
        "laravel",
        "REST"
    ],
    "homepage": "https://github.com/laravelui5/odata",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Gerzabek",
            "email": "michael.gerzabek@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "LaravelUi5\\OData\\": "src/",
            "LaravelUi5\\OData\\Tests\\": "tests/",
            "LaravelUi5\\OData\\Fixtures\\": "tests-fixtures/"
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "orchestra/testbench": "^10.0",
        "phpstan/phpstan": "^1.0.0",
        "nunomaduro/collision": "^8.0",
        "brianium/paratest": "^7.0",
        "eclipxe/xmlschemavalidator": "^3.0",
        "sebastian/diff": "^6.0",
        "ext-pdo_pgsql": "*",
        "ext-pdo_mysql": "*",
        "ext-pdo_sqlite": "*",
        "staudenmeir/eloquent-json-relations": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test-parallel": "testbench package:test --parallel",
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover clover.xml",
        "analyse": "phpstan analyse --memory-limit 1G",
        "translate": "@php bin/translate.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUi5\\OData\\ODataServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    }
}
