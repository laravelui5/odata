includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/mrpunyapal/peststan/extension.neon

parameters:
    level: 1
    paths:
        - src
        - tests
    peststan:
        testCaseClass: LaravelUi5\OData\Tests\TestCase
        pestConfigFiles:
            - tests/Pest.php
    ignoreErrors:
        # Contract tests assert a type PHPStan already knows statically ("implements X").
        # They are regression guards for the class hierarchy, not dead assertions.
        -
            identifier: pest.expectation.redundant
            path: tests/*
