includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    ignoreErrors:
        # Contract tests assert a type PHPStan already knows statically ("implements X").
        # They are regression guards for the class hierarchy, not dead assertions.
        -
            identifier: pest.expectation.redundant
            path: tests/*
        # The same kind of guard written without Pest: is_subclass_of() on two interfaces whose relation PHPStan
        # already knows. Kept because it fails the day someone cuts the interface hierarchy.
        -
            identifier: function.alreadyNarrowedType
            path: tests/Service/Contracts/SqlQueryInterfaceTest.php
        # The filter parser leaves path segments as strings until PropertyResolver resolves them; the segment type
        # (PropertyPathExpression::$segments) does not say so yet. Seen from level 4 up; the fix is OP45.
        -
            identifier: function.impossibleType
            path: src/Protocol/Parser/PropertyResolver.php
            reportUnmatched: false
